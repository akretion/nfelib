<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema XML de validação do Evento de Desfazimento da Alienação da NF-e ABI (NT 2026.001) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.portalfiscal.inf.br/nfeabi" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" targetNamespace="http://www.portalfiscal.inf.br/nfeabi" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="eventoNFeABITiposBasico_v1.00.xsd"/>
	<xs:element name="evDesfazimAlienac">
		<xs:annotation>
			<xs:documentation>Schema XML de validação do Evento de Desfazimento da Alienação da NF-e ABI (ZZC01 - NT 2026.001). Registra o desfazimento de uma operação de alienação de bem imóvel (distrato, resolução, decisão judicial, sentença arbitral, reversão da consolidação da propriedade etc.).</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="descEvento">
					<xs:annotation>
						<xs:documentation>Descrição do Evento (ZZC01b) - “Evento de Desfazimento da Alienação”</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:whiteSpace value="preserve"/>
							<xs:enumeration value="Evento de Desfazimento da Alienação"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="tpDesfaz">
					<xs:annotation>
						<xs:documentation>Tipo de desfazimento (ZZC02). Verificar Tabela de códigos da NF-e ABI, publicada no Portal da NF-e ABI (ex.: distrato, decisão judicial, reversão da consolidação da propriedade; 99=Outros).</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:whiteSpace value="preserve"/>
							<xs:pattern value="[0-9]{2}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="dtDesfaz" type="TData">
					<xs:annotation>
						<xs:documentation>Data do ato de desfazimento (ZZC03), formato AAAA-MM-DD. Ex.: data do instrumento de distrato ou da decisão judicial.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="xDesfaz" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Descrição do ato de desfazimento (ZZC04). Obrigatório quando tpDesfaz=99 (Outros).</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="TString">
							<xs:whiteSpace value="preserve"/>
							<xs:minLength value="5"/>
							<xs:maxLength value="150"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="versao" type="TVerEvento" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
